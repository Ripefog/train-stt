# ── GPUS ─────────────────────────────────────────────────────
CUDA_VISIBLE_DEVICES=1

# ── Docker ─────────────────────────────────────────────────────
SKIP_PREPROCESSING=true
# SKIP_PREPROCESSING=false

# Sau khi extract xong, copy fbank_data → fbank_data_save (copy thật, không hard link
# vì to_file/LilcomChunkyWriter ghi đè tại chỗ, giữ nguyên inode).
# Bật thì cần thêm dung lượng bằng fbank_data và ~15 phút cho 75GB.
SAVE_FBANK=false

BUILD=true
# LUÔN để true. DETACH=false chạy `docker run --rm -it`: container chết theo terminal bị
# ngắt, và --rm xoá container cùng toàn bộ `docker logs` + exit code khi nó thoát, nên mất
# luôn bằng chứng lúc crash. Log của icefall ở callbacks/log/ là nguồn duy nhất còn lại.
DETACH=true
USE_SCREEN=false
IMAGE_NAME=zipformer-training:latest

# ── Test mode ──────────────────────────────────────────────────
# TEST_MODE=true: lấy tối đa TEST_SAMPLES file mỗi dataset để test nhanh pipeline
TEST_MODE=false
TEST_SAMPLES=50
# TEST_SAMPLES=100

# ── WandB ──────────────────────────────────────────────────────
WANDB_API_KEY=
WANDB_PROJECT=conformer-training
WANDB_RUN_NAME=zipformer-training-vi

# ── Training hyperparameters ───────────────────────────────────
NUM_EPOCHS=38
# đã tồn tại {START_EPOCH-1}.pt
START_EPOCH=36

# Zipformer dùng dynamic batching: MAX_DURATION = tổng số giây audio mỗi batch (không phải số mẫu)
# MAX_DURATION=300
MAX_DURATION=600
# for train (full model)
# BASE_LR=0.045
# LR_BATCHES=7500
# LR_EPOCHS=3.5
# for finetune toàn bộ (lr nhỏ để không phá weight gốc)
BASE_LR=0.000015
LR_BATCHES=7500
LR_EPOCHS=3

# Freeze options (chọn 1 trong 2 cách, không dùng cả hai):
#   FREEZE_ENCODER=true              → freeze encoder, train toàn bộ output heads (~6.7%)
#   TRAINABLE_MODULES=joiner         → freeze hết, chỉ train joiner (transducer)
#   TRAINABLE_MODULES=ctc_output     → freeze hết, chỉ train CTC head
TRAINABLE_MODULES=joiner

# ── Model heads ────────────────────────────────────────────────
USE_TRANSDUCER=true
USE_CTC=true

# ── Eval ───────────────────────────────────────────────────────
# EVAL_FIRST=true: tính WER (train + val) trước khi bắt đầu train
EVAL_FIRST=true
# số cut đầu của tập train dùng để đo TRAIN WER mỗi epoch (0 = tắt)
# so TRAIN WER với VALID WER để biết là domain mismatch hay model chưa học được
TRAIN_EVAL_CUTS=1000
# WER_DECODE=ctc|transducer|both — path nào dùng để tính WER
#   transducer = path THỰC SỰ được export sang ONNX (export_onnx.py không export
#                ctc_output), nên đây mới là số phản ánh model deploy
#   ctc        = chỉ đo CTC head (argmax, nhanh hơn nhiều)
#   both       = đo cả hai, encoder chỉ forward 1 lần nên không gấp đôi chi phí
WER_DECODE=both
# Chỉ đo WER trên audio >= N giây, áp cho CẢ val VÀ train-eval để chỉ số "WER gap" giữa
# hai cái có nghĩa (cùng phân phối độ dài). Val 549 → 478 cut khi N=1.0; trong 71 cut bị
# loại có nhiều lỗi cắt đoạn (0,40s mà 5 từ = 12,5 từ/giây, không đọc nổi).
# Đổi giá trị này là ĐỔI VAL SET → WER không so được với lần đo trước. 0 = tắt.
EVAL_MIN_DURATION=1.0

# ── Logging ────────────────────────────────────────────────────────────────
# in loss mỗi N batch. 2.340h ≈ 14.450 batch/epoch, nên mức 50 của icefall gốc
# cho ~289 dòng/epoch, rất khó đọc.
LOG_INTERVAL=200

# ── Checkpoint settings ────────────────────────────────────────
# giữ tối đa N checkpoint gần nhất
KEEP_LAST_K=20
# mid-epoch checkpoint: tắt (save-every-n hardcode 9999999 trong entrypoint.sh)


# ── Data preprocessing ─────────────────────────────────────────
# số luồng song song cho Fbank extraction
NUM_WORKERS=8

# ── Mô phỏng băng tần hẹp của val ──────────────────────────────────────────
# Val là thoại call-center: nội dung phổ THẬT chỉ tới ~3 kHz (vách −70 dB trong
# 2→3,4 kHz, codec narrowband). Sample rate 11.025 Hz chỉ là vỏ sau transcode —
# ĐỪNG suy băng tần từ sample rate. Data train thì trải đều cả băng. Đo trên fbank,
# bin 54–79 (>3 kHz) so với quy chiếu 200–800 Hz per-frame:
#     val −65,1 dB | FPT clean/noise +22 dB | public +47…+50 dB
# Lệch này ở tầng acoustic ⇒ nằm trong ENCODER, nên FREEZE_ENCODER/TRAINABLE_MODULES
# không chạm tới được.
#
# Hai cách sửa, CHỌN MỘT (bật cả hai = cắt băng 2 lần, train.py sẽ raise):
#
# 1) BAND_LIMIT_SR — cắt trên waveform lúc extract (prepare_data.py).
#    Hạ xuống N Hz (low-pass ở N/2) rồi đưa lại 16k. 0 = tắt. 6000 ⇒ low-pass 3 kHz.
#    CHỈ ÁP CHO TẬP TRAIN — val giữ nguyên đường gốc 11.025 Hz → 16 kHz, vì val là bản
#    đại diện cho audio deploy thật: transform nó là đổi thước đo và buộc inference phải
#    áp cùng chuỗi. (Đo được: band-limit val còn làm nó XẤU đi, −63,7 → −58,4 dB, vì
#    resampler thêm gợn cao hơn cả sàn leakage tự nhiên của val.) Trong tập train thì áp
#    cho MỌI dataset, kể cả dataset đã 16k.
#    Đo với 6000 + filter width 16: train từ +47,5 dB trên val về −2,8 dB (nguồn 16k) và
#    −6,6 dB (FPT 8k), val byte-identical.
#    Đừng dùng 11025 (Nyquist 5512): nó bỏ nguyên dải 3–5,5 kHz — 17/26 bin lệch —
#    và với FPT 8 kHz thì hơi PHẢN tác dụng (+18,5 → +20,0 dB).
#    ⚠️  Đổi giá trị ⇒ phải extract vào thư mục fbank KHÁC, không trộn với bản cũ.
#        prepare_data.py ghi FEATURE_CONFIG.txt vào thư mục fbank để đánh dấu.
BAND_LIMIT_SR=0
#    lowpass_filter_width của resampler. Mặc định torchaudio là 6 — filter quá ngắn,
#    stopband nông, và đó là TOÀN BỘ phần dư khi khớp val: width 6 → +10,2 dB, 16 → −2,8,
#    32 → −5,6, 64 → −6,4, 128 → −6,3 (bão hoà). 16 khớp val sát nhất.
BAND_LIMIT_FILTER_WIDTH=16
#
# 2) BAND_CLAMP_BIN — ép mel bin từ N trở lên xuống sàn đo được của val (train.py).
#    54 = bin đầu tiên có tâm > 3000 Hz. 0 = tắt. Chỉ có số đo cho bin >= 54.
#    Không cần extract lại (0 phút) và khớp val CHÍNH XÁC 0 dB, vì tác động thẳng vào
#    đại lượng cần khớp. Chỉ áp cho train_dl, chèn TRƯỚC SpecAugment (SpecAugment mặc
#    định che tới 27/80 bin nên có thể phá dải quy chiếu 6–23). Val giữ nguyên ⇒ WER
#    vẫn so được với baseline cũ, và inference không phải sửa gì.
#    Cái giá: sàn phẳng tất định, không nguồn audio thật nào có như vậy.
BAND_CLAMP_BIN=0


# ── BPE model ──────────────────────────────────────────────────
BPE_URL=https://huggingface.co/hynt/Zipformer-30M-RNNT-6000h/resolve/main/bpe.model
